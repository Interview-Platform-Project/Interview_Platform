NODE_ENV=development
PORT=3000
GLOBAL_PREFIX="api"
API_VERSION="v1"
CORS_ORIGIN="http://localhost:3001"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itzoom?schema=public
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -hex 64
JWT_SECRET=secret-access-key
JWT_REFRESH_SECRET=secret-refresh-key
# Token lifetimes in milliseconds
JWT_ACCESS_EXPIRES_MS=900000      # 15 minutes
JWT_REFRESH_EXPIRES_MS=604800000  # 7 days

# S3 Object Storage (MinIO locally, Timeweb/Selectel in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=itzoom
# {bucket} is replaced with S3_BUCKET at runtime:
#   MinIO (path-style):          http://localhost:9000/{bucket}
#   Timeweb (path-style):        https://s3.timeweb.cloud/{bucket}
#   Yandex (virtual-hosted):     https://{bucket}.storage.yandexcloud.net
S3_PUBLIC_URL=http://localhost:9000/{bucket}
S3_FORCE_PATH_STYLE=true  # required for MinIO; set false for Timeweb/Yandex
