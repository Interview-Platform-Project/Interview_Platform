NODE_ENV=development
PORT=3000
GLOBAL_PREFIX="api"
API_VERSION="v1"
CORS_ORIGIN="http://localhost:3001"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itzoom?schema=public
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -hex 64
JWT_SECRET=secret-access-key
JWT_REFRESH_SECRET=secret-refresh-key
# Token lifetimes in milliseconds
JWT_ACCESS_EXPIRES_MS=900000      # 15 minutes
JWT_REFRESH_EXPIRES_MS=604800000  # 7 days
