model InterviewTopic {
  id String @id @default(uuid())

  name        String  @unique
  slug        String  @unique
  description String?
  order       Int     @default(0)
  categoryId  String  @map("category_id")
  isActive    Boolean @default(true) @map("is_active")

  category InterviewTopicCategory  @relation(fields: [categoryId], references: [id])
  profiles ProfileInterviewTopic[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("interview_topics")
}

model InterviewTopicCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  order    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  topics InterviewTopic[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("interview_topic_categories")
}

model ProfileInterviewTopic {
  profileId String @map("profile_id")
  topicId   String @map("topic_id")

  profiles Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topics   InterviewTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([profileId, topicId])
  @@map("profile_interview_topics")
}
