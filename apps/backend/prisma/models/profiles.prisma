model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  avatarUrl       String? @map("avatar_url")
  positionId      String? @map("position_id")
  bio             String?
  country         String?
  city            String?
  timezone        String?
  github          String?
  linkedin        String?
  website         String?
  hourlyRate      Int?    @map("hourly_rate")
  experienceYears Int?    @map("experience_years")

  stats           ProfileStatistics?
  marketplace     MarketplaceCard?
  technologies    ProfileTechnology[]
  languages       ProfileLanguage[]
  leaderboard     Leaderboard?
  status          ProfileStatus           @default(OFFLINE)
  workExperiences WorkExperience[]
  interviewTopics ProfileInterviewTopic[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@map("profiles")
}
