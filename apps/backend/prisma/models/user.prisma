model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String
  avatarKey String? @map("avatar_key")

  profile    Profile?
  credential Credential?
  feedbacks  Feedback[]
  sessions   Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
